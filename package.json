{
  "name": "storetify",
  "version": "1.3.0",
  "description": "Enhanced localStorage with expiration, subscription, and full TypeScript support",
  "main": "./dist/storetify.cjs.js",
  "module": "./dist/storetify.esm.js",
  "browser": "./dist/storetify.min.js",
  "unpkg": "./dist/storetify.min.js",
  "types": "./dist/storetify.d.ts",
  "scripts": {
    "init": "pnpm install && pnpm run build",
    "dev": "pnpm --filter playground dev",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "test": "jest --no-cache",
    "build": "swiftlet build",
    "build:playground": "pnpm --filter playground build",
    "prepublishOnly": "npm run test && npm run build",
    "pub": "npm publish",
    "prepare": "husky install",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "commit:check": "lavy commit --test",
    "commit:config": "lavy commit --config"
  },
  "keywords": [
    "localStorage",
    "store",
    "subscribe",
    "listener",
    "storetify"
  ],
  "files": [
    "dist",
    "README.zh-CN.md"
  ],
  "author": "Gavin Ray <gavinbirkhoff@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gvray/storetify/issues"
  },
  "homepage": "https://github.com/gvray/storetify#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.2",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^9.39.4",
    "eslint-config-lavy": "^2.0.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lavy": "^2.0.6",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.1",
    "swiftlet": "^1.2.2",
    "ts-jest": "^29.2.5",
    "tslib": "^1.14.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}